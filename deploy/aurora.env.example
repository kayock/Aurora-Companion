# /etc/aurora/aurora.env — environment for the aurora-companion systemd unit.
# Copy to /etc/aurora/aurora.env and adjust. Values here beat the config
# file only where run.py exposes flags; everything else belongs in
# /etc/aurora/config.yaml (see deploy/config.portable.yaml).

# Shown by `systemctl show aurora-companion -p Environment`; free-form.
AURORA_HOME=/opt/aurora-companion
AURORA_CONFIG=/etc/aurora/config.yaml

# Uncomment to pin the dashboard's bind address/port (defaults come from
# the config file: host 0.0.0.0, port 8795 for LAN access on Portable).
# AURORA_HOST=0.0.0.0
# AURORA_PORT=8795

# Python hygiene inside the service (kept out of the unit file for easy edits).
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
